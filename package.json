{
  "name": "crusade-tools",
  "displayName": "Crusade Tools",
  "description": "Monitor and analyze Crusade project logs (error.log, spritecount.log)",
  "version": "0.0.1",
  "publisher": "valentin",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:log"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crusade-tools.createCharacter",
        "title": "🎮 Create New Character",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.toggleWatch",
        "title": "🎮 Toggle Log Watch",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.clearLogs",
        "title": "🎮 Clear All Logs",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openErrorLog",
        "title": "🎮 Open error.log",
        "category": "Crusade"
      }
    ]
  },
  "scripts": {
    "vsce": "vsce",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x",
    "@types/mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}