{
  "name": "crusade-tools",
  "displayName": "Crusade Tools",
  "description": "Monitor and analyze Crusade project logs (error.log, spritecount.log)",
  "version": "0.0.1",
  "publisher": "valentin",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crusade-tools.createCharacter",
        "title": "🎮 Create New Character",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.toggleWatch",
        "title": "🎮 Toggle Log Watch",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.clearLogs",
        "title": "🎮 Clear All Logs",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openErrorLog",
        "title": "🎮 Open error.log",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openFighter",
        "title": "Open Fighter",
        "category": "Crusade"
      }
    ],
    "viewsContainers": {
        "activitybar": [
            {
                "id": "crusade",
                "title": "Crusade Tools",
                "icon": "media/icon.svg"
            }
        ]
    },
    "views": {
        "crusade":[
            {
                "id":"crusadeExplorer",
                "name":"Explorer",
                "icon": "media/icon.svg"
            }
        ]

    },
    "menus": {
      "view/item/context": [
          {
              "command": "crusade-tools.openFighter",
              "when": "view == crusadeExplorer",
              "group": "navigation"
            }
        ]
    },
    "configuration": {
      "title": "Crusade Tools",
      "properties": {
          "crusade-tools.autoWatch": {
              "type": "boolean",
              "default": true,
              "description": "Automatically watch Crusade logs"
          },
          "crusade-tools.gamePath": {
              "type": "string",
              "default": "",
              "description": "Path to Smash Crusade executable"
          }
      }
    }
  },
  "scripts": {
    "vsce": "vsce",
    "pretest": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x",
    "@types/mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}