{
  "name": "crusade-tools",
  "displayName": "Crusade Tools",
  "description": "Monitor and analyze Crusade project logs (error.log, spritecount.log)",
  "version": "0.0.1",
  "publisher": "valentin",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "smash crusade",
    "game maker",
    "modding",
    "fighter",
    "stage",
    "sprite",
    "moveset"
  ],
  "activationEvents": [
    "workspaceContains:INDEX",
    "workspaceContains:fighter",
    "workspaceContains:stage",
    "onView:crusadeExplorer",
    "onCommand:crusade-tools.createCharacter",
    "onCommand:crusade-tools.openErrorLog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "crusade-script",
        "aliases": [
          "Crusade Script"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crusade-script",
        "scopeName": "source.crusade-script",
        "path": "./syntaxes/crusade.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "crusade-tools.createCharacter",
        "title": "🎮 Create New Character",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.toggleWatch",
        "title": "🎮 Toggle Log Watch",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.clearLogs",
        "title": "🎮 Clear All Logs",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openErrorLog",
        "title": "🎮 Open error.log",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openFighter",
        "title": "Open Fighter",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "Crusade",
        "icon": "$(refresh)"
      },
      {
        "command": "crusade-tools.openGame",
        "title": "Launch Smash Crusade",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.compileCharacter",
        "title": "Compile Character",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openPalette",
        "title": "Open Palette",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.openMusic",
        "title": "Open Music",
        "category": "Crusade"
      },
      {
        "command": "crusade-tools.previewSprite",
        "title": "Preview Sprite",
        "category": "Crusade"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crusade",
          "title": "Crusade Tools",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "crusade": [
        {
          "id": "crusadeExplorer",
          "name": "Explorer",
          "icon": "media/icon.svg"
        },
        {
          "id": "crusadeDiagnostics",
          "name": "Diagnostics"
        },
        {
          "id": "crusadeAssets",
          "name": "Assets"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "crusade-tools.refreshExplorer",
          "when": "view == crusadeExplorer",
          "group": "navigation"
        },
        {
          "command": "crusade-tools.createCharacter",
          "when": "view == crusadeExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "crusade-tools.openGame",
          "when": "view == crusadeExplorer",
          "group": "1_run"
        },
        {
          "command": "crusade-tools.compileCharacter",
          "when": "viewItem == fighter",
          "group": "2_build"
        },
        {
          "command": "crusade-tools.previewSprite",
          "when": "viewItem == file && resourceExtname == .png",
          "group": "3_preview"
        },
        {
          "command": "crusade-tools.playMusic",
          "when": "viewItem == file && (resourceExtname == .ogg || resourceExtname == .mp3 || resourceExtname == .wav)",
          "group": "3_preview"
        }
      ]
    },
    "configuration": {
      "title": "Crusade Tools",
      "properties": {
        "crusade-tools.autoWatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically watch Crusade logs"
        },
        "crusade-tools.gamePath": {
          "type": "string",
          "default": "",
          "description": "Path to Smash Crusade executable"
        }
      }
    }
  },
  "scripts": {
    "vsce": "vsce",
    "pretest": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
